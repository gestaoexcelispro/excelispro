'use client'

import {
  useCallback,
  useEffect,
  useMemo,
  useState,
} from 'react'
import Link from 'next/link'
import { createClient } from '../../../../lib/supabase/client'
import styles from './daily-reports.module.css'

function getErrorMessage(error) {
  if (!error) {
    return 'An unexpected error occurred.'
  }

  if (error.code === '23505') {
    return 'A Daily Report already exists for this project and date.'
  }

  if (error.code === '23503') {
    return 'This record is connected to other project information and cannot be changed.'
  }

  if (error.code === '42501') {
    return 'Your account does not have permission to perform this action.'
  }

  return (
    error.message ||
    'The requested operation could not be completed.'
  )
}

function getLocalDateKey(date = new Date()) {
  const year = date.getFullYear()
  const month = String(date.getMonth() + 1).padStart(2, '0')
  const day = String(date.getDate()).padStart(2, '0')

  return `${year}-${month}-${day}`
}

function formatReportDate(value) {
  if (!value) {
    return '—'
  }

  const [year, month, day] = value.split('-').map(Number)

  const date = new Date(year, month - 1, day)

  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: '2-digit',
    year: 'numeric',
  }).format(date)
}

function formatWeekday(value) {
  if (!value) {
    return ''
  }

  const [year, month, day] = value.split('-').map(Number)

  const date = new Date(year, month - 1, day)

  return new Intl.DateTimeFormat('en-US', {
    weekday: 'long',
  }).format(date)
}

function formatTime(value) {
  if (!value) {
    return '—'
  }

  const [hours, minutes] = value.split(':')

  const date = new Date()
  date.setHours(Number(hours), Number(minutes), 0, 0)

  return new Intl.DateTimeFormat('en-US', {
    hour: 'numeric',
    minute: '2-digit',
  }).format(date)
}

function formatUpdatedAt(value) {
  if (!value) {
    return '—'
  }

  const date = new Date(value)

  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: '2-digit',
    hour: 'numeric',
    minute: '2-digit',
  }).format(date)
}

function getStatusLabel(status) {
  const labels = {
    draft: 'Draft',
    submitted: 'Submitted',
    reviewed: 'Reviewed',
    approved: 'Approved',
  }

  return labels[status] || status
}

export default function DailyReportsPage() {
  const supabase = useMemo(() => createClient(), [])

  const [userId, setUserId] = useState(null)
  const [projects, setProjects] = useState([])
  const [selectedProject, setSelectedProject] = useState(null)
  const [reports, setReports] = useState([])
  const [isLoading, setIsLoading] = useState(true)
  const [isCreating, setIsCreating] = useState(false)
  const [errorMessage, setErrorMessage] = useState('')
  const [noticeMessage, setNoticeMessage] = useState('')

  const today = getLocalDateKey()

  const loadWorkspace = useCallback(async () => {
    setIsLoading(true)
    setErrorMessage('')

    const queryParameters = new URLSearchParams(
      window.location.search
    )

    const selectedProjectId = queryParameters.get('projectId')

    const {
      data: userData,
      error: userError,
    } = await supabase.auth.getUser()

    if (userError || !userData?.user) {
      setErrorMessage(
        'Your authenticated session could not be verified.'
      )
      setIsLoading(false)
      return
    }

    setUserId(userData.user.id)

    const {
      data: projectsData,
      error: projectsError,
    } = await supabase
      .from('projects')
      .select(`
        id,
        code,
        name,
        client_name,
        organization_id,
        status,
        created_at
      `)
      .neq('status', 'archived')
      .order('created_at', { ascending: false })

    if (projectsError) {
      setErrorMessage(getErrorMessage(projectsError))
      setIsLoading(false)
      return
    }

    const availableProjects = projectsData || []

    setProjects(availableProjects)

    if (!selectedProjectId) {
      setSelectedProject(null)
      setReports([])
      setIsLoading(false)
      return
    }

    const activeProject = availableProjects.find(
      (project) => project.id === selectedProjectId
    )

    if (!activeProject) {
      setSelectedProject(null)
      setReports([])
      setErrorMessage(
        'The selected project does not exist or your account cannot access it.'
      )
      setIsLoading(false)
      return
    }

    setSelectedProject(activeProject)

    const {
      data: reportsData,
      error: reportsError,
    } = await supabase
      .from('daily_reports')
      .select(`
        id,
        organization_id,
        project_id,
        report_number,
        report_date,
        status,
        work_start_time,
        work_end_time,
        general_notes,
        submitted_at,
        reviewed_at,
        approved_at,
        created_at,
        updated_at
      `)
      .eq('project_id', selectedProjectId)
      .order('report_date', { ascending: false })
      .order('report_number', { ascending: false })

    if (reportsError) {
      setErrorMessage(getErrorMessage(reportsError))
      setReports([])
      setIsLoading(false)
      return
    }

    setReports(reportsData || [])
    setIsLoading(false)
  }, [supabase])

  useEffect(() => {
    loadWorkspace()
  }, [loadWorkspace])

  const todayReport = useMemo(
    () =>
      reports.find(
        (report) => report.report_date === today
      ) || null,
    [reports, today]
  )

  const reportSummary = useMemo(() => {
    const approved = reports.filter(
      (report) => report.status === 'approved'
    ).length

    const inWorkflow = reports.filter(
      (report) =>
        report.status === 'submitted' ||
        report.status === 'reviewed'
    ).length

    const drafts = reports.filter(
      (report) => report.status === 'draft'
    ).length

    return {
      total: reports.length,
      approved,
      inWorkflow,
      drafts,
    }
  }, [reports])

  function changeProject(projectId) {
    window.location.href =
      `/dashboard/projects/daily-reports?projectId=${projectId}`
  }

  async function createTodayReport() {
    if (
      !selectedProject ||
      !userId ||
      todayReport ||
      isCreating
    ) {
      return
    }

    setIsCreating(true)
    setErrorMessage('')
    setNoticeMessage('')

    const highestReportNumber = reports.reduce(
      (highest, report) =>
        Math.max(
          highest,
          Number(report.report_number) || 0
        ),
      0
    )

    const nextReportNumber = highestReportNumber + 1

    const {
      data,
      error,
    } = await supabase
      .from('daily_reports')
      .insert({
        organization_id: selectedProject.organization_id,
        project_id: selectedProject.id,
        report_number: nextReportNumber,
        report_date: today,
        status: 'draft',
        created_by: userId,
      })
      .select(`
        id,
        organization_id,
        project_id,
        report_number,
        report_date,
        status,
        work_start_time,
        work_end_time,
        general_notes,
        submitted_at,
        reviewed_at,
        approved_at,
        created_at,
        updated_at
      `)
      .single()

    if (error) {
      setErrorMessage(getErrorMessage(error))
      setIsCreating(false)
      return
    }

    setReports((currentReports) =>
      [data, ...currentReports].sort((a, b) =>
        b.report_date.localeCompare(a.report_date)
      )
    )

    setNoticeMessage(
      `Daily Report #${String(data.report_number).padStart(
        3,
        '0'
      )} was created successfully.`
    )

    setIsCreating(false)
  }

  if (isLoading) {
    return (
      <div className={styles.loadingState}>
        <span className={styles.loadingSpinner} />
        <p>Loading Daily Reports...</p>
      </div>
    )
  }

  if (errorMessage && projects.length === 0) {
    return (
      <div className={styles.errorState}>
        <h1 className={styles.errorTitle}>
          Daily Reports unavailable
        </h1>

        <p className={styles.errorDescription}>
          {errorMessage}
        </p>

        <button
          type="button"
          className={styles.primaryButton}
          onClick={loadWorkspace}
        >
          Try again
        </button>
      </div>
    )
  }

  if (!selectedProject) {
    return (
      <div className={styles.container}>
        <section className={styles.heading}>
          <div className={styles.headingContent}>
            <p className={styles.eyebrow}>
              Field reporting
            </p>

            <h1 className={styles.title}>
              Daily Reports
            </h1>

            <p className={styles.description}>
              Select a project to create, review and manage
              its daily field records.
            </p>
          </div>

          <Link
            href="/dashboard/projects"
            className={styles.backLink}
          >
            ← Back to projects
          </Link>
        </section>

        <article className={styles.panel}>
          <div className={styles.panelHeader}>
            <div>
              <h2 className={styles.panelTitle}>
                Select a project
              </h2>

              <p className={styles.panelDescription}>
                Daily Reports are maintained independently for
                each project.
              </p>
            </div>

            <span className={styles.projectCount}>
              {projects.length === 1
                ? '1 project'
                : `${projects.length} projects`}
            </span>
          </div>

          {projects.length === 0 ? (
            <div className={styles.emptyState}>
              <h3 className={styles.emptyTitle}>
                No projects available.
              </h3>

              <p className={styles.emptyDescription}>
                Create a project before creating Daily Reports.
              </p>

              <Link
                href="/dashboard/projects"
                className={styles.primaryButton}
              >
                Open projects
              </Link>
            </div>
          ) : (
            <div className={styles.projectGrid}>
              {projects.map((project) => (
                <button
                  type="button"
                  className={styles.projectCard}
                  onClick={() =>
                    changeProject(project.id)
                  }
                  key={project.id}
                >
                  <div className={styles.projectIdentity}>
                    <span className={styles.projectName}>
                      {project.name}
                    </span>

                    <span className={styles.projectClient}>
                      {project.code || 'Unassigned'} ·{' '}
                      {project.client_name ||
                        'Client not specified'}
                    </span>
                  </div>

                  <span
                    className={styles.projectArrow}
                    aria-hidden="true"
                  >
                    →
                  </span>
                </button>
              ))}
            </div>
          )}
        </article>
      </div>
    )
  }

  const summaryItems = [
    {
      label: 'Total reports',
      value: reportSummary.total,
      detail: 'Project history',
    },
    {
      label: 'Approved',
      value: reportSummary.approved,
      detail: 'Final records',
    },
    {
      label: 'In review',
      value: reportSummary.inWorkflow,
      detail: 'Submitted or reviewed',
    },
    {
      label: 'Drafts',
      value: reportSummary.drafts,
      detail: 'Still editable',
    },
  ]

  return (
    <div className={styles.container}>
      <section className={styles.heading}>
        <div className={styles.headingContent}>
          <p className={styles.eyebrow}>
            Field reporting & production records
          </p>

          <h1 className={styles.title}>
            Daily Report Center
          </h1>

          <p className={styles.description}>
            Record field conditions, workforce, production,
            materials, issues and supporting evidence for each
            workday.
          </p>
        </div>

        <div className={styles.projectSelector}>
          <label
            htmlFor="daily-report-project"
            className={styles.projectSelectorLabel}
          >
            Active project
          </label>

          <select
            id="daily-report-project"
            className={styles.projectSelectorInput}
            value={selectedProject.id}
            onChange={(event) =>
              changeProject(event.target.value)
            }
          >
            {projects.map((project) => (
              <option
                value={project.id}
                key={project.id}
              >
                {project.code || 'Unassigned'} ·{' '}
                {project.name}
              </option>
            ))}
          </select>
        </div>
      </section>

      <section
        className={styles.summaryGrid}
        aria-label="Daily Report summary"
      >
        {summaryItems.map((item) => (
          <article
            className={styles.summaryCard}
            key={item.label}
          >
            <p className={styles.summaryLabel}>
              {item.label}
            </p>

            <p className={styles.summaryValue}>
              {item.value}
            </p>

            <p className={styles.summaryDetail}>
              {item.detail}
            </p>
          </article>
        ))}
      </section>

      {errorMessage && (
        <div
          className={styles.inlineError}
          role="alert"
        >
          {errorMessage}
        </div>
      )}

      {noticeMessage && (
        <div
          className={styles.notice}
          role="status"
        >
          <span className={styles.noticeIcon}>
            ✓
          </span>

          <span>{noticeMessage}</span>

          <button
            type="button"
            className={styles.noticeClose}
            onClick={() => setNoticeMessage('')}
            aria-label="Close notification"
          >
            ×
          </button>
        </div>
      )}

      <section className={styles.todayPanel}>
        <div className={styles.todayHeader}>
          <div>
            <p className={styles.todayEyebrow}>
              Today · {formatWeekday(today)}
            </p>

            <h2 className={styles.todayTitle}>
              {formatReportDate(today)}
            </h2>
          </div>

          {todayReport ? (
            <span
              className={`${styles.statusBadge} ${
                styles[
                  `status_${todayReport.status}`
                ] || ''
              }`}
            >
              {getStatusLabel(todayReport.status)}
            </span>
          ) : (
            <span className={styles.noReportBadge}>
              No report yet
            </span>
          )}
        </div>

        {todayReport ? (
          <div className={styles.todayReport}>
            <div className={styles.todayReportIdentity}>
              <span className={styles.reportNumber}>
                Daily Report #
                {String(
                  todayReport.report_number
                ).padStart(3, '0')}
              </span>

              <span className={styles.reportProject}>
                {selectedProject.code ||
                  selectedProject.name}
              </span>
            </div>

            <div className={styles.todayMetadata}>
              <div>
                <span className={styles.metadataLabel}>
                  Work start
                </span>

                <strong>
                  {formatTime(
                    todayReport.work_start_time
                  )}
                </strong>
              </div>

              <div>
                <span className={styles.metadataLabel}>
                  Work end
                </span>

                <strong>
                  {formatTime(
                    todayReport.work_end_time
                  )}
                </strong>
              </div>

              <div>
                <span className={styles.metadataLabel}>
                  Last update
                </span>

                <strong>
                  {formatUpdatedAt(
                    todayReport.updated_at
                  )}
                </strong>
              </div>
            </div>

            <div className={styles.todayActions}>
              <span className={styles.nextStepText}>
                Report workspace will be connected in the next
                step.
              </span>
            </div>
          </div>
        ) : (
          <div className={styles.todayEmpty}>
            <div>
              <h3 className={styles.todayEmptyTitle}>
                No Daily Report has been created for today.
              </h3>

              <p className={styles.todayEmptyDescription}>
                Start today&apos;s field record for this
                project. The report will be created as a Draft.
              </p>
            </div>

            <button
              type="button"
              className={styles.primaryButton}
              onClick={createTodayReport}
              disabled={isCreating}
            >
              {isCreating
                ? 'Creating...'
                : '+ Create Daily Report'}
            </button>
          </div>
        )}
      </section>

      <section className={styles.panel}>
        <div className={styles.panelHeader}>
          <div>
            <p className={styles.eyebrow}>
              Project record
            </p>

            <h2 className={styles.panelTitle}>
              Report History
            </h2>

            <p className={styles.panelDescription}>
              Daily field records created for{' '}
              {selectedProject.name}.
            </p>
          </div>

          <span className={styles.projectCount}>
            {reports.length}{' '}
            {reports.length === 1
              ? 'report'
              : 'reports'}
          </span>
        </div>

        {reports.length === 0 ? (
          <div className={styles.emptyState}>
            <div className={styles.emptyIcon}>
              DR
            </div>

            <h3 className={styles.emptyTitle}>
              No Daily Reports yet.
            </h3>

            <p className={styles.emptyDescription}>
              Create the first field report to begin building
              the project&apos;s daily history.
            </p>
          </div>
        ) : (
          <div className={styles.tableContainer}>
            <table className={styles.table}>
              <thead>
                <tr>
                  <th>Report</th>
                  <th>Date</th>
                  <th>Day</th>
                  <th>Status</th>
                  <th>Work hours</th>
                  <th>Last update</th>
                </tr>
              </thead>

              <tbody>
                {reports.map((report) => (
                  <tr key={report.id}>
                    <td>
                      <strong
                        className={styles.tableReportNumber}
                      >
                        #
                        {String(
                          report.report_number
                        ).padStart(3, '0')}
                      </strong>
                    </td>

                    <td>
                      {formatReportDate(
                        report.report_date
                      )}
                    </td>

                    <td className={styles.mutedCell}>
                      {formatWeekday(
                        report.report_date
                      )}
                    </td>

                    <td>
                      <span
                        className={`${styles.statusBadge} ${
                          styles[
                            `status_${report.status}`
                          ] || ''
                        }`}
                      >
                        {getStatusLabel(
                          report.status
                        )}
                      </span>
                    </td>

                    <td className={styles.mutedCell}>
                      {report.work_start_time ||
                      report.work_end_time
                        ? `${formatTime(
                            report.work_start_time
                          )} – ${formatTime(
                            report.work_end_time
                          )}`
                        : '—'}
                    </td>

                    <td className={styles.mutedCell}>
                      {formatUpdatedAt(
                        report.updated_at
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <div className={styles.footerNote}>
        <span className={styles.footerDot} />

        Daily Reports operates independently and can connect to
        Planning & Production Control when both modules are
        enabled.
      </div>
    </div>
  )
}
